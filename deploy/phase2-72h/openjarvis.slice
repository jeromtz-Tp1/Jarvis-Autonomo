# Presupuesto TOTAL de OpenJarvis en el host compartido (protege a OpenClaw).
# Valores por defecto: 10 GB y 6 CPU (validados en la PC real con qwen3.5:4b + voz). repair_lab.sh/setup_lab.sh los ajustan a la VM con un drop-in persistente.
[Unit]
Description=OpenJarvis test slice (72h trial, resource-capped)

[Slice]
MemoryHigh=9728M
MemoryMax=10G
MemorySwapMax=0
CPUQuota=600%
CPUWeight=50
IOWeight=50
TasksMax=512
