[Unit]
Description=OpenJarvis trial - API server + managed agents (loopback only)
After=ojl-ollama.service
Requires=ojl-ollama.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Slice=openjarvis.slice
User=jarvis
Group=jarvis
WorkingDirectory=/opt/oj/workspace
EnvironmentFile=/opt/oj/deploy/ojl.env
ExecStart=/opt/oj/venv/bin/jarvis serve --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10
KillMode=control-group
TimeoutStopSec=30
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/oj/home /opt/oj/logs /opt/oj/workspace
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Egreso: solo loopback (Ollama, MCP local). Sin salida a Internet durante la prueba (R8, R9).
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
