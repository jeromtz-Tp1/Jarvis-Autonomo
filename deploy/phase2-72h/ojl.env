# Variables NO sensibles. Ningún token/clave aquí.
HOME=/opt/oj/home
OPENJARVIS_HOME=/opt/oj/home/.openjarvis
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=/opt/oj/home/.ollama/models
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=8192
HF_HOME=/opt/oj/home/.cache/huggingface
HF_HUB_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
# R8: el sondeo del motor NIM apunta a un puerto cerrado local en vez de integrate.api.nvidia.com
NIM_HOST=http://127.0.0.1:9
# R2: la allowlist de config.toml es autoritativa (requiere patches/0001)
OPENJARVIS_STRICT_TOOLS=1
